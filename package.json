{
  "name": "personal-blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seo:check": "node --import tsx scripts/seo-check.ts",
    "test": "node --import tsx --test scripts/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run lint && npm test && npm run seo:check && env NOTION_TOKEN= NOTION_DATABASE_ID= REVALIDATE_SECRET= NEXT_TELEMETRY_DISABLED=1 npm run build && npm run smoke"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "dotenv": "^17.2.3",
    "feed": "^4.2.2",
    "framer-motion": "^12.23.24",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "schema-dts": "^1.1.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
